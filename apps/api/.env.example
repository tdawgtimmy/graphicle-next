ENVIRONMENT=development

# Supabase Postgres. Use the DIRECT connection, not the Supavisor pooler: this
# API is a long-lived container with its own SQLAlchemy pool.
# Local default matches supabase/config.toml (db.port = 54332).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54332/postgres

# Provider is a model string, so switching vendors is config, not a rewrite.
LLM_MODEL=anthropic:claude-opus-5
ANTHROPIC_API_KEY=

# Only needed in the fallback shape where the API is public instead of a Render
# private service. Empty means same-origin only (the default, via the proxy).
# CORS_ORIGINS=["https://graphicle.onrender.com"]
